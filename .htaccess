# KRISHNA TOOLS — clean URLs + security.
# NOTE: the installer regenerates this file (adding an install-lock guard that
# blocks /install/ after setup). This committed copy makes clean URLs work the
# moment files are uploaded, before the installer runs.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^tool/([a-z0-9-]+)/?$ tool.php?slug=$1 [L,QSA]
  RewriteRule ^category/([a-z0-9-]+)/?$ category.php?slug=$1 [L,QSA]
  RewriteRule ^convert/([a-z0-9.\-]+)/?$ convert.php?slug=$1 [L,QSA]
  RewriteRule ^blog/([a-z0-9-]+)/?$ blog/post.php?slug=$1 [L,QSA]
  # Sitemap index + children
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^sitemap-main\.xml$ sitemap-main.php [L]
  RewriteRule ^sitemap-convert\.xml$ sitemap-convert.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-XSS-Protection "1; mode=block"
</IfModule>

<FilesMatch "^(config\.php|\.env|.*\.log|.*\.sql)$">
  Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
